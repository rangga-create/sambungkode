# Salin file ini menjadi .env lalu isi nilainya.

# ---- Server ----
PORT=4000
CORS_ORIGIN=http://localhost:3000

# ---- Firebase (wajib agar API berfungsi) ----
# 1. Buat project di https://console.firebase.google.com
# 2. Project settings → Service accounts → Generate new private key
# 3. Salin nilai project_id, client_email, private_key dari file JSON tersebut
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Alternatif: jalan tanpa kredensial asli memakai Firebase Emulator Suite
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# ---- Seed (npm run seed) ----
SEED_ADMIN_EMAIL=admin@sambungkode.id
# Wajib diisi bila akun admin belum ada:
SEED_ADMIN_PASSWORD=
SEED_PARTICIPANT_PASSWORD=peserta123
SEED_SESSION_CODE=SBK-01
